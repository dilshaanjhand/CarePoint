<TreatmentScreen>
    name: "treatment"
    size_hint: .7,1
    pos_hint: {"center_x":.5, "center_y":.5}
    GridLayout:
        spacing: "15dp"
        cols:1

        #image

        Label:
            text: "Welcome Doctor"
            font_size: "30dp"
            color: 0,0,0,1,
            bold: True
            size_hint: 1,0.15

        GridLayout:
            spacing: "5dp"
            cols:2

            Label:
                text: "Enter the sickness the \npatient has:"
                color: 0,0,0,1,
                bold: True
                font_size: "22dp"
            TextInput:
                id:treatment_disease_input
                multiline: False
        Button:
            text: "Submit"
            bold: True
            font_size: "30dp"
            background_color: 0,1,0.5,1,
            background_normal: ""
            size_hint:.1,.4
            on_press: root.on_press_button_treatment()

        ScrollView:
            size_hint: 1, 0.6
            do_scroll_x: False
            do_scroll_y: True

            GridLayout:
                cols: 1
                size_hint_y: None
                height: self.minimum_height

                Label:
                    text: root.treatment_cure
                    text_size: self.width, None
                    size_hint_y: None
                    height: self.texture_size[1]
                    valign: 'top'
                    halign: 'left'
                    color: 0,0,0,1
                    bold: False
                    font_size: "20dp"

        Button:
            text: "Back to Home"
            bold: True
            font_size: "30dp"
            background_color: 0,0.5,1,1,
            background_normal: ""
            size_hint:.1,.4
            on_release: app.root.current="doctor"
        Button:
            text: "Sign Out"
            bold: True
            font_size: "30dp"
            background_color: 1,0,0,1,
            background_normal: ""
            size_hint:.1,.4
            on_release: app.root.current="login"
        
