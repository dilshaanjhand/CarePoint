            bold: True
            size_hint: 1,0.15

        GridLayout:
            spacing: "5dp"
            cols:2

            Label:
                text: "Enter Symptoms\n(Separate with commas!):"
                color: 0,0,0,1,
                bold: True
                font_size: "22dp"
            TextInput:
                id:symptoms_input
                multiline: False
        
        Button:
            text: "Submit"
            bold: True
            font_size: "30dp"
