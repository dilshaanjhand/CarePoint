                Label:
                    text: root.disease
                    text_size: self.width, None
                    size_hint_y: None
                    height: self.texture_size[1]
                    valign: 'top'
                    halign: 'left'
                    color: 0,0,0,1
                    bold: False
                    font_size: "20dp"
        
            
        Button:
            text: "Back to Home"
            bold: True
            font_size: "30dp"
            background_color: 0,0.5,1,1,
            background_normal: ""
            size_hint:.1,.4
